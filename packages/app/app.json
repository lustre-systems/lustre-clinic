{
    "expo": {
        "name": "Lustre Clinic",
        "slug": "lustre-clinic",
        "version": "0.0.0",
        "runtimeVersion": {
            "policy": "fingerprint"
        },
        "orientation": "portrait",
        "icon": "./assets/icon.png",
        "userInterfaceStyle": "light",
        "ios": {
            "supportsTablet": true
        },
        "android": {
            "package": "com.lustre.clinic",
            "adaptiveIcon": {
                "backgroundColor": "#14110F",
                "foregroundImage": "./assets/android-icon-foreground.png",
                "backgroundImage": "./assets/android-icon-background.png",
                "monochromeImage": "./assets/android-icon-monochrome.png"
            },
            "allowBackup": false,
            "predictiveBackGestureEnabled": true,
            "softwareKeyboardLayoutMode": "resize"
        },
        "plugins": [
            "expo-font",
            "expo-background-task",
            "expo-secure-store",
            "./plugins/withBuildTuning",
            "./plugins/withCleartextTraffic",
            "./plugins/withDevIdentity",
            "./plugins/withNavigationBarContrast",
            "./plugins/withReleaseSigning",
            "./plugins/withReleaseVersionCode",
            "@react-native-community/datetimepicker",
            [
                "expo-notifications",
                {
                    "icon": "./assets/notification-icon.png",
                    "color": "#111114"
                }
            ],
            [
                "expo-camera",
                {
                    "cameraPermission": "Lustre uses the camera to scan the code that gives this phone its role.",
                    "recordAudioAndroid": false,
                    "barcodeScannerEnabled": true
                }
            ],
            "@sentry/react-native/expo"
        ],
        "extra": {
            "server": {
                "lan": null,
                "tailscale": null
            },
            "demo": false
        },
        "scheme": ["com.lustre.clinic", "com.lustre.clinic.dev"]
    }
}
