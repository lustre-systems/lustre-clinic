        "@trpc/tanstack-react-query": "11.18.0",
        "expo": "~57.0.9",
        "expo-application": "~57.0.3",
        "expo-auth-session": "^57.0.12",
        "expo-camera": "~57.0.5",
        "expo-constants": "^57.0.9",
        "expo-dev-client": "~57.0.19",
        "expo-file-system": "~57.0.2",
        "expo-font": "~57.0.1",
        "expo-notifications": "~57.0.18",
