{
    "name": "@lustre/app",
    "version": "0.0.0",
    "private": true,
    "main": "index.ts",
    "scripts": {
        "start": "expo start",
        "android": "expo run:android",
        "device": "bash scripts/device.sh",
        "device:build": "bash scripts/device.sh --build",
        "device:release": "bash scripts/device.sh --release",
        "device:start": "bash scripts/device.sh --start",
        "device:logs": "adb logcat -s ReactNativeJS:V ReactNative:V",
        "device:stop": "cd android && ./gradlew --stop",
        "emu": "bash scripts/emulator.sh",
        "emu:build": "bash scripts/emulator.sh --build",
        "emu:release": "bash scripts/emulator.sh --release",
        "emu:start": "bash scripts/emulator.sh --start",
        "emu:shot": "bash scripts/emulator.sh --shot",
        "waydroid": "bash scripts/waydroid.sh",
        "waydroid:build": "bash scripts/waydroid.sh --build",
        "waydroid:release": "bash scripts/waydroid.sh --release",
        "waydroid:start": "bash scripts/waydroid.sh --start",
        "waydroid:shot": "bash scripts/waydroid.sh --shot",
        "waydroid:stop": "bash scripts/waydroid.sh --stop",
        "ios": "expo run:ios",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@expo-google-fonts/dm-mono": "^0.4.2",
